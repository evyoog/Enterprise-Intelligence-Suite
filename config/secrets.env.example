# ============================================================================
# EIS common secrets file — TEMPLATE (safe to commit: no real values)
#
# Copy to config/secrets.env and fill in real values. config/secrets.env is
# git-ignored and must never be committed. Rule: docs/03-business-rules/
# BR-SEC-001-central-secrets-file.md
#
# Every API key, client secret, password and signing key EIS uses belongs here.
# A new integration adds its variables to this template in the same change.
# ============================================================================

# ---- Database ---------------------------------------------------------------
# The spring.datasource block in application.yml is intentionally unchanged;
# these variables override its defaults.
DB_USER=
DB_PASSWORD=

# ---- Keycloak (identity) ----------------------------------------------------
KEYCLOAK_ROPC_CLIENT_ID=
KEYCLOAK_ROPC_CLIENT_SECRET=
KEYCLOAK_IMPERSONATION_CLIENT_ID=
KEYCLOAK_IMPERSONATION_CLIENT_SECRET=

# ---- Email (SMTP) -----------------------------------------------------------
SMTP_USER=
SMTP_PASSWORD=

# ---- Platform signing and encryption keys -----------------------------------
# Encrypts stored MFA secrets. Changing it makes existing MFA enrolments unreadable.
PLATFORM_MFA_ENCRYPTION_KEY=
# Shared secret for the internal SSO bridge to the hosted product backends.
INTERNAL_SSO_SHARED_SECRET=

# ---- Razorpay (payments) — REQ-BIL-001, docs/09-integrations/razorpay.md ----
# Leave empty until the product owner provides them: EIS then runs in
# "Payment gateway not configured" mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- External tax provider (REQ-BIL-002, C96) -------------------------------
# Used only when "External Tax Engine" is switched on in Platform Admin -> Billing -> Tax Configuration.
# Leave empty to use the internal rules engine. These values never leave the backend: no API returns them.
# The base URL is the provider's API root (https). The backend adds /capabilities and /calculate
# (docs/06-api/api-requirements/tax-rules.md, "External provider contract v1").
TAX_PROVIDER_BASE_URL=
TAX_PROVIDER_API_KEY=
# Optional: when set, every request is signed with HMAC-SHA256 in the X-Signature header.
TAX_PROVIDER_API_SECRET=

# ---- Embedding model for semantic search (REQ-PRT-003, C70) ----------------
# Leave empty to run keyword search only. Which model is used is Not
# specified yet; it must be an open-source multilingual sentence-transformers
# model (English + Spanish) producing 384-dimensional vectors.
# Backend: address of ai-service, for example http://localhost:8000
EMBEDDING_SERVICE_URL=
# ai-service: sentence-transformers (real model) or stub (tests only)
EMBEDDING_PROVIDER=
# ai-service: model id or local path
EMBEDDING_MODEL=
# ai-service: text some models expect before queries / passages (for example "query: ")
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=

# ---- Knowledge media storage, AWS S3 (REQ-KNW-003, C72) — Draft, not built --
# Private bucket, presigned URLs only (BR-MED-001, docs/09-integrations/aws-s3.md).
# These keys stay on the server: never in the frontend, browser or API responses.
# Leave commented until REQ-KNW-003 is approved and built.
# EIS_KNOWLEDGE_AWS_ACCESS_KEY_ID=
# EIS_KNOWLEDGE_AWS_SECRET_ACCESS_KEY=

# ---- YouTube Data API (REQ-KNW-004, C73) — optional, Draft, not built ------
# Without a key EIS reads video details from YouTube oEmbed
# (docs/09-integrations/youtube.md).
# EIS_YOUTUBE_API_KEY=
