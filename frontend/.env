# Left unset on purpose — client.ts derives this from the page's own host at
# runtime (so opening via localhost or a LAN IP both just work). Set this
# explicitly only for a real deployed domain where the API isn't on the same
# host:8081 convention.
# VITE_API_BASE_URL=http://localhost:8081/api

VITE_KEYCLOAK_URL=https://user.evyoog.com
VITE_KEYCLOAK_REALM=eVyoog
VITE_KEYCLOAK_CLIENT_ID=eis-platform-ui

# Local dev — active by default
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_KEYCLOAK_SILENT_REDIRECT_URI=http://localhost:5173/auth/silent-renew
VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# Live — uncomment these three and comment the three above when deploying
# VITE_KEYCLOAK_REDIRECT_URI=https://<your-live-domain>/auth/callback
# VITE_KEYCLOAK_SILENT_REDIRECT_URI=https://<your-live-domain>/auth/silent-renew
# VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://<your-live-domain>
